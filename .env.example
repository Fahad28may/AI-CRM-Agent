# Copy this file to .env and fill in real values. Never commit .env.

# Neon Postgres: pooled connection for the app, direct/unpooled for migrations.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=""

# OpenRouter (AI provider)
OPENROUTER_API_KEY=""
# OpenRouter model slug used for all AI CRM Agent calls. Defaults to the
# free openai/gpt-oss-20b:free if unset (no OpenRouter credits required).
# Switch to a paid model (e.g. anthropic/claude-haiku-4.5) before launch —
# see src/lib/ai/client.ts.
AI_MODEL=""

# HubSpot OAuth app (create at https://developers.hubspot.com)
HUBSPOT_CLIENT_ID=""
HUBSPOT_CLIENT_SECRET=""
HUBSPOT_REDIRECT_URI="http://localhost:3000/api/crm/hubspot/callback"

# Used to encrypt stored OAuth tokens/credentials at rest (32-byte key, base64)
CREDENTIALS_ENCRYPTION_KEY=""

# Base URL used to build links in emails (password reset, verification, etc.)
APP_URL="http://localhost:3000"

# Authorizes the cron sweep at /api/cron/jobs (retries jobs that didn't
# complete inline). Generate with: openssl rand -base64 32
CRON_SECRET=""
