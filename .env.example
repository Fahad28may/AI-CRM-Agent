# Copy this file to .env and fill in real values. Never commit .env.

# Neon Postgres: pooled connection for the app, direct/unpooled for migrations.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=""

# OpenRouter (AI provider)
OPENROUTER_API_KEY=""

# HubSpot OAuth app (create at https://developers.hubspot.com)
HUBSPOT_CLIENT_ID=""
HUBSPOT_CLIENT_SECRET=""
HUBSPOT_REDIRECT_URI="http://localhost:3000/api/crm/hubspot/callback"

# Used to encrypt stored OAuth tokens/credentials at rest (32-byte key, base64)
CREDENTIALS_ENCRYPTION_KEY=""

# Base URL used to build links in emails (password reset, verification, etc.)
APP_URL="http://localhost:3000"
